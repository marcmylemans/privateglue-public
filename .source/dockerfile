FROM python:3.11-slim

WORKDIR /app

# Create non-root user and group
RUN groupadd --system --gid 1000 appgroup \
    && useradd --system --uid 1000 --gid appgroup --home /app --no-create-home appuser

# ping and ip: used by the optional "scan from this server" feature (off by default).
RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/backend
# Setup guides for the integrations, shown inside the app.
COPY documentation/integrations/ /app/documentation/integrations
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Data, notes, backups, and secret dirs are bind/volume mounted in docker-compose.
# Pre-create them so they exist on first run with correct ownership.
RUN mkdir -p /app/data /app/notes /app/backups /app/secret \
    && chown -R appuser:appgroup /app \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

# Set by CI from the git tag or commit, shown in the app footer and System page.
ARG APP_VERSION=""
ENV PYTHONPATH="${PYTHONPATH}:/app" \
    PYTHONUNBUFFERED=1 \
    APP_VERSION=${APP_VERSION}

# No "USER appuser" here on purpose: the entrypoint starts as root only to fix ownership
# of the data folders (needed when upgrading from older images that ran as root), then
# drops to appuser before the app starts. The app itself never runs as root.

EXPOSE 5000

# Built-in health check (the image has no curl, so use Python).
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/healthz', timeout=5)"

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--access-logfile", "-", "--error-logfile", "-", "backend.app:app"]
